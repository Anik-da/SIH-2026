# ============================================================
# COSMOPLOT 3D - Environment Configuration Template
# SIH 2026 — SIH26011
# ============================================================

# Backend API Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=cosmoplot

# Frontend API Base URL (leave empty or set to http://localhost:5000 for local proxy)
VITE_API_BASE_URL=http://localhost:5000

# Cesium Ion Access Token (Required for 3D Photorealistic Tiles & Terrain)
VITE_CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_token_here
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Firebase Authentication (Optional for cloud authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
